execute_process(COMMAND ${NM} --defined-only ${ELF} OUTPUT_VARIABLE listing)
string(REPLACE "\n" ";" lines "${listing}")
set(map "")
foreach(line ${lines})
    if(line MATCHES "^([0-9a-fA-F]+) [A-Za-z] (.+)$")
        string(APPEND map "${CMAKE_MATCH_1} ${CMAKE_MATCH_2}\n")
    endif()
endforeach()
file(WRITE ${OUT} "${map}")
